{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finanproof Claim Record",
  "description": "核查记录统一数据契约，三人共用的唯一版本",
  "type": "object",
  "required": ["claim_id", "claim_text", "source_reference"],
  "properties": {
    "claim_id": { "type": "string" },
    "claim_text": { "type": "string" },
    "claim_type": {
      "enum": ["financial_metric", "growth_rate", "ratio", "valuation_multiple", "citation", "qualitative", "other"]
    },
    "report_value": { "type": ["number", "null"] },
    "report_unit": { "type": ["string", "null"] },
    "source_value": { "type": ["number", "null"] },
    "source_unit": { "type": ["string", "null"] },
    "calculated_value": { "type": ["number", "null"] },
    "period": { "type": ["string", "null"] },
    "currency": { "enum": ["CNY", "USD", "HKD", "其他", null] },
    "scope": { "enum": ["合并", "母公司", "归母", "扣非", "未知", null] },
    "is_adjusted": { "type": ["boolean", "null"] },
    "source_reference": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "page": { "type": ["integer", "null"] },
        "table": { "type": ["string", "null"] },
        "row": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "error_type": { "enum": ["E01", "E02", "E03", "E04", "E05", "E06", "E07", "E08", "E09", "E10", null] },
    "severity": { "enum": ["high", "medium", "low", null] },
    "evidence": { "type": ["string", "null"] },
    "correction": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "minimum": 0, "maximum": 1] }
  }
}
